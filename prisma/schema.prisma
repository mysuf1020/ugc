datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id                 String       @id @default(uuid())
  title              String
  brandName          String
  productDescription String
  targetAudience     String?
  tone               String       @default("casual")
  targetDurationSec  Int          @default(30)
  aspectRatio        String       @default("9:16")
  status             String       @default("DRAFT") // DRAFT, GENERATING, COMPLETED, FAILED

  // AI Talking Avatar Fields
  avatarImageUrl     String?      // Path foto wajah kreator
  productImageUrl    String?      // Path foto produk/brand
  scriptText         String?      // Naskah yang diucapkan
  voiceId            String       @default("id-ID-ArdiNeural")
  layoutStyle        String       @default("SPLIT_SCREEN") // SPLIT_SCREEN, PIP_BUBBLE, FULL_PRESENTER
  hookHeadline       String?      // Teks banner viral atas
  talkingVideoUrl    String?      // Video hasil Lip-sync (D-ID / Replicate)
  finalVideoUrl      String?      // Video akhir MP4 9:16 hasil composite

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  scripts            Script[]
  scenes             Scene[]
  exports            VideoExport[]
}

model Script {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hookText          String
  problemText       String
  solutionText      String
  demoText          String
  ctaText           String
  fullScript        String
  hookOptions       String?
  selectedHookIndex Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Scene {
  id           String      @id @default(uuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderIndex   Int
  sceneType    String
  title        String
  scriptLine   String
  durationEst  Float       @default(5.0)
  mediaType    String      @default("CAMERA_TAKE")
  activeTakeId String?
  overlayText  String?
  textStyle    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  takes        SceneTake[]
}

model SceneTake {
  id          String   @id @default(uuid())
  sceneId     String
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  takeNumber  Int
  filePath    String
  durationSec Float    @default(0.0)
  fileSize    Int      @default(0)
  mimeType    String   @default("video/webm")
  createdAt   DateTime @default(now())
}

model VideoExport {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolution   String    @default("1080x1920")
  outputPath   String?
  fileSize     Int?
  status       String    @default("PENDING")
  progress     Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
}

model AppSetting {
  id                     String   @id @default("global_settings")
  aiProviderPreference   String   @default("gemini")
  geminiApiKey           String?
  openAiApiKey           String?
  elevenLabsApiKey       String?
  defaultTtsVoice        String   @default("id-ID-ArdiNeural")
  adminPin               String?
  
  // Talking Avatar AI Keys
  talkingAvatarProvider  String   @default("did") // did, replicate
  dIdApiKey              String?  // Basic Auth API Key D-ID
  replicateApiToken      String?  // Replicate API Token
  
  updatedAt              DateTime @updatedAt
}
